{
  "manifest_version": 3,
  "name": "DreamGraph Computer Use",
  "version": "14.0.2",
  "description": "Lets DreamGraph's Architect operate this browser when you grant Computer Use. Connects only to the DreamGraph host on this computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DreamGraph Computer Use",
    "default_popup": "popup.html"
  },
  "key": ""
}
